# Deny every top-level path, then allow only production build inputs.
/*

!/.vercelignore
!/.gitignore
!/package.json
!/package-lock.json
!/next.config.ts
!/next-env.d.ts
!/tsconfig.json
!/postcss.config.mjs

!/app
!/app/**
!/components
!/components/**
!/data
!/data/**
!/lib
!/lib/**

!/public
/public/*
!/public/favicon.svg
!/public/art
/public/art/*

!/public/art/cursor
/public/art/cursor/*
!/public/art/cursor/mouse.png

!/public/art/magical-loom-fixed
/public/art/magical-loom-fixed/*
!/public/art/magical-loom-fixed/background.png
!/public/art/magical-loom-fixed/foreground-left.png
!/public/art/magical-loom-fixed/foreground-right.png
!/public/art/magical-loom-fixed/gear-left.png
!/public/art/magical-loom-fixed/gear-right.png
!/public/art/magical-loom-fixed/gear-top.png
!/public/art/magical-loom-fixed/rear-arch.png

!/public/art/magical-loom
/public/art/magical-loom/*
!/public/art/magical-loom/aligned
/public/art/magical-loom/aligned/*
!/public/art/magical-loom/aligned/03_crystal.webp
!/public/art/magical-loom/aligned/04_fabric.webp
!/public/art/magical-loom/website-woven-at-last.webp

!/public/art/weavers
/public/art/weavers/*
!/public/art/weavers/bb.webp
!/public/art/weavers/bbq-cutout-v2.webp
!/public/art/weavers/qiqi.webp
